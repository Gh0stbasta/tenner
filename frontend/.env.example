# Base URL of the Tenner API stage, without trailing slash.
# CI sets all values from Terraform outputs (deploy.yml).
VITE_API_BASE_URL=https://api.example.com/prod

# Cognito login (SECURITY-003): outputs cognito_issuer_url, cognito_client_id, cognito_login_url.
VITE_COGNITO_ISSUER_URL=https://cognito-idp.eu-central-1.amazonaws.com/eu-central-1_EXAMPLE
VITE_COGNITO_CLIENT_ID=exampleclientid
VITE_COGNITO_LOGIN_URL=https://tenner-prod-example.auth.eu-central-1.amazoncognito.com
