{
  "type": "APL",
  "version": "2023.2",
  "theme": "dark",
  "description": "Tenner household dashboard (ALEXA-006). Datasource: payload.view = DashboardView (alexa/src/apl.ts).",
  "settings": {
    "idleTimeout": 120000
  },
  "resources": [
    {
      "description": "Dark surface and text tokens; member colors come from the datasource.",
      "colors": {
        "background": "#1c1f24",
        "surface": "#262a31",
        "text": "#ffffff",
        "muted": "#b8bec6",
        "primary": "#1976d2",
        "banner": "#123b63",
        "warning": "#ffd479"
      },
      "dimensions": {
        "pad": "32dp",
        "gap": "16dp",
        "bodySize": "32dp",
        "detailSize": "26dp",
        "titleSize": "44dp",
        "summarySize": "30dp",
        "rowMinHeight": "64dp",
        "boxSize": "36dp"
      }
    },
    {
      "description": "Echo Show 15/21 (1920 dp wide): larger type for viewing distance.",
      "when": "${viewport.width >= 1600}",
      "dimensions": {
        "pad": "56dp",
        "gap": "24dp",
        "bodySize": "40dp",
        "detailSize": "32dp",
        "titleSize": "60dp",
        "summarySize": "38dp",
        "rowMinHeight": "80dp",
        "boxSize": "44dp"
      }
    },
    {
      "description": "Echo Show 5 (960x480 dp): less padding, large type.",
      "when": "${viewport.width < 1100 && viewport.height < 600}",
      "dimensions": {
        "pad": "24dp",
        "gap": "8dp",
        "titleSize": "40dp",
        "summarySize": "28dp",
        "rowMinHeight": "64dp"
      }
    }
  ],
  "layouts": {
    "TennerRow": {
      "description": "One touchable Tenner (>= 48 dp target); 'Erledigt' via SendEvent.",
      "parameters": [
        "row"
      ],
      "item": {
        "type": "TouchWrapper",
        "role": "button",
        "accessibilityLabel": "${row.accessibilityLabel}",
        "minHeight": "@rowMinHeight",
        "spacing": "4dp",
        "onPress": [
          {
            "type": "SendEvent",
            "arguments": [
              "complete",
              "${row.tennerId}",
              "${row.title}"
            ]
          }
        ],
        "item": {
          "type": "Container",
          "direction": "row",
          "alignItems": "center",
          "minHeight": "@rowMinHeight",
          "items": [
            {
              "type": "Frame",
              "width": "@boxSize",
              "height": "@boxSize",
              "borderWidth": "3dp",
              "borderColor": "@muted",
              "borderRadius": "8dp"
            },
            {
              "type": "Container",
              "grow": 1,
              "shrink": 1,
              "paddingLeft": "16dp",
              "items": [
                {
                  "type": "Text",
                  "text": "${row.label}",
                  "fontSize": "@bodySize",
                  "color": "@text",
                  "maxLines": 2
                },
                {
                  "type": "Text",
                  "text": "${row.detail}",
                  "display": "${row.detail == '' ? 'none' : 'normal'}",
                  "fontSize": "@detailSize",
                  "color": "@warning",
                  "maxLines": 1
                }
              ]
            }
          ]
        }
      }
    },
    "MemberColumn": {
      "description": "Due-today Tenners of one member (or 'Alle'); the color bar is identity, the name is always written.",
      "parameters": [
        "column"
      ],
      "item": {
        "type": "Container",
        "grow": 1,
        "shrink": 1,
        "basis": "0",
        "paddingRight": "@gap",
        "items": [
          {
            "type": "Frame",
            "width": "72dp",
            "height": "6dp",
            "borderRadius": "3dp",
            "backgroundColor": "${column.color}"
          },
          {
            "type": "Text",
            "text": "${column.name}",
            "fontSize": "@summarySize",
            "fontWeight": "bold",
            "color": "@text",
            "paddingTop": "8dp",
            "paddingBottom": "8dp"
          },
          {
            "type": "Container",
            "data": "${column.rows}",
            "items": [
              {
                "type": "TennerRow",
                "row": "${data}"
              }
            ]
          },
          {
            "type": "Text",
            "text": "${column.more}",
            "display": "${column.more == '' ? 'none' : 'normal'}",
            "fontSize": "@detailSize",
            "color": "@muted"
          }
        ]
      }
    },
    "Header": {
      "parameters": [
        "view"
      ],
      "item": {
        "type": "Container",
        "items": [
          {
            "type": "Container",
            "direction": "row",
            "alignItems": "center",
            "items": [
              {
                "type": "Text",
                "text": "${view.title}",
                "fontSize": "@titleSize",
                "fontWeight": "bold",
                "color": "@primary",
                "grow": 1
              },
              {
                "type": "Text",
                "text": "${view.date}",
                "fontSize": "@summarySize",
                "color": "@muted"
              }
            ]
          },
          {
            "type": "Text",
            "text": "${view.summary}",
            "fontSize": "@summarySize",
            "color": "@text",
            "paddingTop": "8dp"
          },
          {
            "type": "Frame",
            "display": "${view.banner == '' ? 'none' : 'normal'}",
            "backgroundColor": "@banner",
            "borderRadius": "12dp",
            "marginTop": "@gap",
            "item": {
              "type": "Text",
              "text": "${view.banner}",
              "fontSize": "@summarySize",
              "color": "@text",
              "paddingLeft": "16dp",
              "paddingRight": "16dp",
              "paddingTop": "8dp",
              "paddingBottom": "8dp"
            }
          }
        ]
      }
    }
  },
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "ScrollView",
        "width": "100vw",
        "height": "100vh",
        "item": {
          "type": "Container",
          "width": "100vw",
          "backgroundColor": "@background",
          "paddingLeft": "@pad",
          "paddingRight": "@pad",
          "paddingTop": "@pad",
          "paddingBottom": "@pad",
          "items": [
            {
              "type": "Header",
              "view": "${payload.view}"
            },
            {
              "type": "Text",
              "text": "${payload.view.empty}",
              "display": "${payload.view.empty == '' ? 'none' : 'normal'}",
              "fontSize": "@bodySize",
              "color": "@text",
              "paddingTop": "@gap"
            },
            {
              "description": "Echo Show 5: next three only",
              "when": "${viewport.width < 1100 && viewport.height < 600}",
              "type": "Container",
              "paddingTop": "@gap",
              "data": "${payload.view.next}",
              "items": [
                {
                  "type": "TennerRow",
                  "row": "${data}"
                }
              ]
            },
            {
              "description": "Portrait (Echo Show 15 upright): stacked",
              "when": "${!(viewport.width < 1100 && viewport.height < 600) && (viewport.height > viewport.width)}",
              "type": "Container",
              "paddingTop": "@gap",
              "items": [
                {
                  "type": "Container",
                  "data": "${payload.view.columns}",
                  "items": [
                    {
                      "type": "MemberColumn",
                      "column": "${data}",
                      "paddingBottom": "@gap"
                    }
                  ]
                },
                {
                  "type": "Text",
                  "text": "${payload.view.moreMembers}",
                  "display": "${payload.view.moreMembers == '' ? 'none' : 'normal'}",
                  "fontSize": "@detailSize",
                  "color": "@muted",
                  "paddingTop": "8dp"
                },
                {
                  "type": "Container",
                  "paddingTop": "@gap",
                  "display": "${payload.view.overdue.length == 0 ? 'none' : 'normal'}",
                  "items": [
                    {
                      "type": "Text",
                      "text": "⚠ Überfällig",
                      "fontSize": "@summarySize",
                      "fontWeight": "bold",
                      "color": "@warning"
                    },
                    {
                      "type": "Container",
                      "data": "${payload.view.overdue}",
                      "items": [
                        {
                          "type": "TennerRow",
                          "row": "${data}"
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "text": "${payload.view.overdueMore}",
                      "display": "${payload.view.overdueMore == '' ? 'none' : 'normal'}",
                      "fontSize": "@detailSize",
                      "color": "@muted"
                    }
                  ]
                }
              ]
            },
            {
              "description": "Landscape Echo Show 8/10/15/21: member columns; overdue band from 1600 dp",
              "when": "${!(viewport.width < 1100 && viewport.height < 600) && !(viewport.height > viewport.width)}",
              "type": "Container",
              "paddingTop": "@gap",
              "items": [
                {
                  "type": "Container",
                  "direction": "row",
                  "data": "${payload.view.columns}",
                  "items": [
                    {
                      "type": "MemberColumn",
                      "column": "${data}"
                    }
                  ]
                },
                {
                  "type": "Text",
                  "text": "${payload.view.moreMembers}",
                  "display": "${payload.view.moreMembers == '' ? 'none' : 'normal'}",
                  "fontSize": "@detailSize",
                  "color": "@muted",
                  "paddingTop": "8dp"
                },
                {
                  "type": "Container",
                  "paddingTop": "@gap",
                  "display": "${payload.view.overdue.length == 0 ? 'none' : 'normal'}",
                  "items": [
                    {
                      "type": "Text",
                      "text": "⚠ Überfällig",
                      "fontSize": "@summarySize",
                      "fontWeight": "bold",
                      "color": "@warning"
                    },
                    {
                      "type": "Container",
                      "data": "${payload.view.overdue}",
                      "items": [
                        {
                          "type": "TennerRow",
                          "row": "${data}"
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "text": "${payload.view.overdueMore}",
                      "display": "${payload.view.overdueMore == '' ? 'none' : 'normal'}",
                      "fontSize": "@detailSize",
                      "color": "@muted"
                    }
                  ],
                  "when": "${viewport.width >= 1600}"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
