{
  "manifest": {
    "id": "shopping-list",
    "version": "1.0.0",
    "installStateChanges": "INFORM",
    "updateStateChanges": "INFORM",
    "presentationDefinitions": [
      {
        "url": "presentations/default.tpl"
      }
    ],
    "appliesTo": "${viewport.mode == 'HUB'}"
  },
  "packageVersion": "1.0",
  "packageType": "APL_PACKAGE",
  "publishingInformation": {
    "schemaVersion": "1.0",
    "locales": {
      "de-DE": [
        {
          "targetViewport": "WIDGET_M",
          "metadata": {
            "name": "Zentrale Einkaufsliste",
            "description": "Die offenen Einträge der Einkaufsliste aus der Zentrale.",
            "keywords": [
              "zentrale",
              "einkaufsliste",
              "einkaufen"
            ],
            "iconUri": "${WEB_APP_URL}/icons/icon-512.png",
            "previews": [
              "${WEB_APP_URL}/alexa/shopping-widget-preview.png"
            ]
          }
        }
      ]
    }
  }
}
